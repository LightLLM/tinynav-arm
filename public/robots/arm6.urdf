<?xml version="1.0"?>
<!-- A simple six-axis arm made of boxes and cylinders, written for this project.
     Z is up, units are metres and radians. The same file drives the browser
     simulator (public/simulator) and the MuJoCo physics simulator (robosim/arm.py). -->
<robot name="arm6">
  <material name="base"><color rgba="0.20 0.22 0.26 1"/></material>
  <material name="blue"><color rgba="0.12 0.37 0.75 1"/></material>
  <material name="light"><color rgba="0.82 0.84 0.88 1"/></material>
  <material name="tool"><color rgba="0.90 0.55 0.10 1"/></material>

  <link name="base_link">
    <inertial><origin xyz="0 0 0.05"/><mass value="4.0"/><inertia ixx="0.012" iyy="0.012" izz="0.016" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.09" length="0.10"/></geometry><material name="base"/></visual>
  </link>

  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/><child link="shoulder"/>
    <origin xyz="0 0 0.10"/><axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="150" velocity="3.0"/>
  </joint>
  <link name="shoulder">
    <inertial><origin xyz="0 0 0.06"/><mass value="3.0"/><inertia ixx="0.007" iyy="0.007" izz="0.007" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.06"/><geometry><cylinder radius="0.07" length="0.12"/></geometry><material name="blue"/></visual>
  </link>

  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder"/><child link="upper_arm"/>
    <origin xyz="0 0 0.12"/><axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="150" velocity="3.0"/>
  </joint>
  <link name="upper_arm">
    <inertial><origin xyz="0 0 0.20"/><mass value="3.0"/><inertia ixx="0.041" iyy="0.041" izz="0.003" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.20"/><geometry><box size="0.07 0.07 0.40"/></geometry><material name="light"/></visual>
  </link>

  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0 0 0.40"/><axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="100" velocity="3.0"/>
  </joint>
  <link name="forearm">
    <inertial><origin xyz="0 0 0.175"/><mass value="2.0"/><inertia ixx="0.021" iyy="0.021" izz="0.0012" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.175"/><geometry><box size="0.06 0.06 0.35"/></geometry><material name="light"/></visual>
  </link>

  <joint name="wrist_pitch" type="revolute">
    <parent link="forearm"/><child link="wrist_1"/>
    <origin xyz="0 0 0.35"/><axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="40" velocity="4.0"/>
  </joint>
  <link name="wrist_1">
    <inertial><origin xyz="0 0 0.05"/><mass value="0.8"/><inertia ixx="0.001" iyy="0.001" izz="0.0007" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.04" length="0.10"/></geometry><material name="blue"/></visual>
  </link>

  <joint name="wrist_yaw" type="revolute">
    <parent link="wrist_1"/><child link="wrist_2"/>
    <origin xyz="0 0 0.10"/><axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="40" velocity="4.0"/>
  </joint>
  <link name="wrist_2">
    <inertial><origin xyz="0 0 0.04"/><mass value="0.6"/><inertia ixx="0.0005" iyy="0.0005" izz="0.0004" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.04"/><geometry><cylinder radius="0.035" length="0.08"/></geometry><material name="light"/></visual>
  </link>

  <joint name="wrist_roll" type="revolute">
    <parent link="wrist_2"/><child link="wrist_3"/>
    <origin xyz="0 0 0.08"/><axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="40" velocity="4.0"/>
  </joint>
  <link name="wrist_3">
    <inertial><origin xyz="0 0 0.03"/><mass value="0.4"/><inertia ixx="0.0003" iyy="0.0003" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.03"/><geometry><box size="0.05 0.05 0.06"/></geometry><material name="blue"/></visual>
  </link>

  <joint name="tool_mount" type="fixed">
    <parent link="wrist_3"/><child link="tool"/>
    <origin xyz="0 0 0.08"/>
  </joint>
  <link name="tool">
    <visual><geometry><sphere radius="0.018"/></geometry><material name="tool"/></visual>
  </link>
</robot>
